*include, input=mesh.inp

*material, name=GCDP, id=GCDP,
** E
25850,
** nu
0.18,
** fcy
10.33,
** fcu
31.0,
** fbu
35.96,
** ftu
2.70,
** Ah
0.85,
** Bh
0.08,
** Ch
0.003,
** Dh
2.0,
** Df
0.000001,
** As
15,
** epsF
0.0017,
** l
2,
** m
1.0,
** maxDMG
.99,
** derivativeMethod (0 ..  AD, 1 ..  CD)
0
** dtThreshild
1e-12
** viscoplasticity
1e-12

*material, name=linearElastic, id=steelLoad
37000.0, 0.3

*section, name=sectConc, material=GCDP, type=solid
concrete
*section, name=secSteel, material=steelLoad, type=solid
reinforced_concrete

*modelModifier, type=hAdaptivity, name=amr
>>marker, type=fieldOutput, fieldOutput=alphaPForAMR, expression='abs(x) > 0.0'
elSet=concrete
maxLevel=1
splitFactor=3

*job, domain=3d, name=theJob
*solver, solver=NISTParallel, name=theSolver

*fieldOutput,
>>perNode, elSet=concrete, name=displacement, field=displacement, result=U
>>perNode, elSet=concrete, name=nonlocal damage, field=nonlocal damage, result=U
>>perNode, name=RF, nSet=nset_load_application, field=displacement, result=P, f(x)='np.sum(x[:,1], axis=0)', saveHistory=True, export=RF
>>perElement, elSet=concrete, name=damage, result=omega, quadraturePoint=0:8, f(x)='np.mean(x,axis=1)'
>>perElement, elSet=concrete, name=alphaP, result=alphaP, quadraturePoint=0:8, f(x)='np.min(x,axis=1)'
>>perElement, elSet=concrete, name=alphaPForAMR, result=alphaP, quadraturePoint=0:8

*output, type=monitor, name=monitor
fieldOutput=RF

*output, type=ensight, name=esExport
>>perNode, fieldOutput=displacement
>>perNode, fieldOutput=nonlocal damage
>>perElement, fieldOutput=damage
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=1e-2, minInc=1e-4, maxNumInc=200, maxIter=25, stepLength=100
>>options, category=NISTSolver, extrapolation=linear
>>dirichlet, name=bottom, nSet=nset_bottom, field=displacement, 2=0, 1=0, 3=0
>>dirichlet, name=load, nSet=nset_load_application, field=displacement, 2=+1
