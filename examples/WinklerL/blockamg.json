{
  "outerSolver": "amgcl_lgmres",
  "outerTol": "adaptive",
  "outerRestart": 50,
  "outerMaxiter": 3,
  "lgmresM": 30,
  "lgmresK": 3,
  "sweeps": 1,
  "symmetric": false,
  "krylovOnScaledSystem": true,
  "fieldPreconds": {
    "displacement": {
      "backendPrecision": "double",
      "backendBlockSize": 1,
      "coarsening": {
        "type": "smoothed_aggregation",
        "aggr": {
          "eps_strong": 0.01
        }
      },
      "relax": {
        "type": "chebyshev",
        "degree": 5,
        "power_iters": 300,
        "lower": 0.01
      },
      "npre": 1,
      "npost": 1
    }
  },
  "useRigidBodyNullspace": true,
  "p1FieldNames": [],
  "hierarchyDropTol": 0.0,
  "etaMin": 1e-4,
  "etaMax": 3e-4,
  "ewGamma": 0.9,
  "ewAlpha": 1.618033988749895,
  "residualGrowthFactor": 4.0,
  "hierarchyStalenessFactor": 1.5,
  "trueResidualMaxContinuations": 0,
  "gapCompensatedTolerance": true,
  "gapSafetyFactor": 0.3,
  "verbosity": "info",
  "warnOuterIterationsThreshold": 100,
  "dumpOnDegradationThreshold": 100,
  "dumpOnDegradationMaxDumps": 10,
  "dumpOnDegradationContextSolves": 0
}
