*material, name=LinearElastic, id=myMaterial, provider=marmothypoelastic
1.8e4, 0.22

*section, name=section1, thickness=1.0, material=myMaterial, type=plane
all

*job, name=cps4job, domain=2d
*solver, solver=NIST, name=theSolver

*fieldOutput
>>perNode, elSet=all, field=displacement, result=U, name=displacement
>>perNode, nSet=gen_bottom, result=P, field=displacement, name=RF
>>perElement, elSet=all, result=stress, name=stress, quadraturePoint=0:4, f(x)='np.mean(x,axis=1)'
>>perElement, elSet=all, result=strain, name=strain, quadraturePoint=0:4, f(x)='np.mean(x,axis=1)'

*modelGenerator, generator=planeRectQuad, name=gen
x0=0, l=10.0
y0=0, h=10.0
elType=CPS4
elProvider=edelweiss
nX=2
nY=2

*output, type=monitor
fieldOutput=RF, f(x)='mean(x[:,1])'
fieldOutput=stress, f(x)="'\n' + np.array2string(x, formatter={'float_kind':'{:>8.2f}'.format})"

*step, solver=theSolver
maxInc=0.5, minInc=1e-5, maxNumInc=10, maxIter=25, stepLength=1
>>dirichlet, name=fix_y, nSet=gen_bottom, field=displacement, 2=0.0
>>dirichlet, name=fix_x, nSet=gen_bottom, field=displacement, 1=0.0
>>dirichlet, name=pull,  nSet=gen_top,    field=displacement, 2=0.1
