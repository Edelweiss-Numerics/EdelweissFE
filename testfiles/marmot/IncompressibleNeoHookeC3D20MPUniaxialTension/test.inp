*material, name=INCOMPRESSIBLENEOHOOKE, id=rubber
1500

*section, name=section1, material=rubber, type=solid
all

*job, name=neoHookeUniaxial, domain=3d
*solver, solver=NISTParallel, name=theSolver

*modelGenerator, generator=boxGen, name=gen
x0=0, y0=0, z0=0
nX=1, nY=1, nZ=1
lX=1, lY=1, lZ=1
elType=C3D20MP

*fieldOutput
>>perNode, elSet=all, field=displacement, result=U, name=displacement
>>perNode, elSet=all, field=pressure, result=U, name=pressure
>>perNode, name=RFx, nSet=gen_right, field=displacement, result=P, f(x)='sum(x[:,0])', saveHistory=True, export=RFx
>>perNode, name=Uy_top, nSet=gen_top, field=displacement, result=U, f(x)='mean(x[:,1])', saveHistory=True, export=Uy_top
>>perNode, name=Uz_front, nSet=gen_front, field=displacement, result=U, f(x)='mean(x[:,2])', saveHistory=True, export=Uz_front

*output, type=monitor, name=mon
fieldOutput=RFx
fieldOutput=Uy_top
fieldOutput=Uz_front

*step, solver=theSolver
maxInc=0.1, minInc=1e-4, maxNumInc=1000, maxIter=25, stepLength=1
>>dirichlet, name=x0, nSet=gen_left,   field=displacement, 1=0
>>dirichlet, name=y0, nSet=gen_bottom, field=displacement, 2=0
>>dirichlet, name=z0, nSet=gen_back,   field=displacement, 3=0
>>dirichlet, name=x1, nSet=gen_right,  field=displacement, 1=0.3
