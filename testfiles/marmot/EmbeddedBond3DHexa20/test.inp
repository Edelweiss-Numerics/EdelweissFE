** 3D: two quadratic steel bars (T3D3, one inclined, one curved) embedded in a concrete block (C3D20R) with
** bond-slip (fib Model Code 2010), split at the host boundaries; the block is sheared and stretched
*material, name=linearelastic, id=concrete, provider=marmot
30000.0, 0.2

*material, name=linearelastic, id=steel, provider=marmot
200000.0, 0.3

*material, name=ModelCode2010BondSlip, id=bond, provider=marmot
13.69, 1.0, 2.0, 10.0, 0.4, 5.48, 200.0, 1000.0

*modelGenerator, generator=boxGen, name=gen
lX=200
lY=100
lZ=100
nX=4
nY=2
nZ=2
elType=C3D20R

*node
100001, 10.0, 20.0, 30.0
100002, 190.0, 80.0, 65.0
100003, 100.0, 50.0, 47.5
100004, 10.0, 70.0, 70.0
100005, 190.0, 70.0, 70.0
100006, 100.0, 85.0, 60.0
100007, 145.0, 65.0, 56.25
100008, 55.0, 35.0, 38.75

*element, type=T3D3
100001, 100001, 100003, 100008
100002, 100003, 100002, 100007
100003, 100004, 100005, 100006

*elSet, elSet=rebars
100001, 100002, 100003

*section, name=concreteSection, material=concrete, type=solid
gen_all

*section, name=rebarSection, area=78.5, material=steel, type=truss
rebars

*modelGenerator, generator=embeddedBond, name=rebarBond, executeAfterManualGeneration=True
rebarElSet=rebars
hostElSet=gen_all
material=bond
perimeter=31.4
splitBars=True

*job, name=job, domain=3d
*solver, solver=NIST, name=theSolver

*fieldOutput
>>perNode, name=displacement, elSet=gen_all, field=displacement, result=U
>>perElement, name=slip, elSet=rebarBond_bond, result=slip, quadraturePoint=0,
>>perNode, name=rebarDisplacement, elSet=rebars, field=displacement, result=U
>>perElement, name=rebarNormalForce, elSet=rebars, result=normal force, quadraturePoint=0,

*output, type=ensight, name=esExport
>>perNode, fieldOutput=rebarDisplacement
>>perElement, fieldOutput=rebarNormalForce
>>perNode, fieldOutput=displacement
>>perElement, fieldOutput=slip
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=0.25, minInc=1e-8, maxNumInc=100, maxIter=15, stepLength=1
>>dirichlet, name=left, nSet=gen_left, field=displacement, 1=0, 2=0, 3=0
>>dirichlet, name=right, nSet=gen_right, field=displacement, 1=0.2, 2=0.1, 3=-0.05
