>>perNode, name=displacement, elSet=gen_all, field=displacement, result=U
>>perNode, name=beamDisplacement, elSet=beams, field=displacement, result=U
>>perNode, name=beamRotation, elSet=beams, field=rotation, result=U
>>perElement, name=bendingMoments, elSet=beams, result=bending moments, quadraturePoint=0,
>>perElement, name=bendingMomentZ, elSet=beams, result=bending moments, quadraturePoint=0, f(x)='x[:,1:2]'
>>perElement, name=torque, elSet=beams, result=torque, quadraturePoint=0,

