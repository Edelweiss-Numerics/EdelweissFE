*material, name=LinearElastic, id=linearelastic, provider=edelweiss
**Isotropic
**E    nu
1.8e4, 0.22

*job, name=c3d8job, domain=3d
*solver, solver=NIST, name=theSolver

*modelGenerator, generator=boxGen, name=block
nX      =12
nY      =12
nZ      =2
lX      =10
lY      =10
lZ      =5
elProvider =edelweiss
elType  =C3D8

** A cylinder (radius 5, axis along z, flat end caps) taken from
** EdelweissMeshfree's discrete rigid body contact example, translated so its
** top cap sits flush with the block's bottom (z=0) face and shifted
** off-center relative to the block's footprint -- so only part of the
** cylinder's flat cap (and, at the far corner, its rounded rim) underlies
** the block, making the contact patch asymmetric.
*modelGenerator, generator=discreteRigidBodyGenerator, name=cylinder
filename=rigid_body.exo
translation='0, -10, -11.0'

** Scoped to block_all rather than all: all also contains the rigid body's
** surface/RP nodes/elements, which cannot take a solid section.
*section, name=section1, material=linearelastic, type=solid
block_all

*constraint, type=nodeToDiscreteRigidBodyPenalty, name=contact
nSet=block_back
rigidBody=cylinder
penalty=1e8

*fieldOutput
>>perNode, elSet=all, field=displacement, name=displacement, result=U
>>perNode, rigidBody=cylinder, field=displacement, name=cylinderDisplacement, result=U
>>perNode, nSet=cylinder_rp, field=displacement, name=rpForce, result=P, f(x)=' sum ( x, axis=0 )'

*output, type=ensight, name=test
>>perNode, fieldOutput=displacement
>>perNode, fieldOutput=cylinderDisplacement
>>configuration, overwrite=yes

*output, type=monitor, name=rpForceMon
fieldOutput=rpForce

*step, solver=theSolver
maxInc=0.1, minInc=1e-9, maxNumInc=100, maxIter=25, stepLength=1
>>options, name=theSolver, extrapolation=off
>>dirichlet, name=frontFixed, nSet=block_front, field=displacement, 1=0.0, 2=0.0, 3=0.0
>>dirichlet, name=rpDisp, nSet=cylinder_rp, field=displacement, 1=0.0, 2=0.0, 3=3.00
>>dirichlet, name=rpRot, nSet=cylinder_rp, field=rotation, 1=0.15, 2=0.0, 3=0.0
