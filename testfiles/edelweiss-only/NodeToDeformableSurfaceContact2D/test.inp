** 2D (plane strain, quad8) counterpart of the frictional drag test: covers the Line2 small-
** sliding kinematics, the 2D Coulomb friction predictor/corrector, the quad8 midside edge split
** of the surface element generator, and the augmented-Lagrange multiplier update -- none of
** which are exercised by the 3D tests. During steady sliding T/N = mu = 0.3 at the fixed base.
*material, name=LinearElastic, id=linearelastic, provider=edelweiss
1.8e4, 0.3

*job, name=contactjob2d, domain=2d
*solver, solver=NIST, name=theSolver

*modelGenerator, generator=planeRectQuad, name=lower
nX      =3
nY      =2
x0      =0
y0      =0
l       =2
h       =1
elType  =CPE8
elProvider =edelweiss

*modelGenerator, generator=planeRectQuad, name=upper
nX      =2
nY      =2
x0      =0.7
y0      =1.05
l       =0.6
h       =1
elType  =CPE8
elProvider =edelweiss

*modelGenerator, generator=surfaceElementGenerator, name=gen1
surface = upper_bottom
name    = slaveSurf
triangulation = midside

*modelGenerator, generator=surfaceElementGenerator, name=gen2
surface = lower_top
name    = masterSurf
triangulation = midside

*section, name=section1, thickness=1.0, material=linearelastic, type=plane
lower_all
upper_all

*constraint, name=contact, type=nodeToDeformableSurfacePenalty
slaveSurface=slaveSurf_facets, masterSurface=masterSurf_facets, penalty=3e6, type=quadratic,
searchDistance=2.0, sliding=small, mu=0.3, tangentPenalty=1e6, augmentedLagrange=True

*fieldOutput
>>perNode, elSet=lower_all, field=displacement, result=U, name=dispLower
>>perNode, elSet=upper_all, field=displacement, result=U, name=dispUpper
>>perNode, name=RFDrag,   nSet=lower_bottom, field=displacement, result=P, f(x)='sum(x[:,0])', saveHistory=True
>>perNode, name=RFNormal, nSet=lower_bottom, field=displacement, result=P, f(x)='sum(x[:,1])', saveHistory=True

*output, type=monitor, name=monitor
fieldOutput=RFDrag
fieldOutput=RFNormal

** step 1: press the upper block on
*step, solver=theSolver
maxInc=0.34, minInc=1e-6, maxNumInc=100, maxIter=25, stepLength=1
>>options, category=NISTSolver, extrapolation=off
>>dirichlet, name=fixLower, nSet=lower_bottom, field=displacement, 1=0.0, 2=0.0
>>dirichlet, name=holdUpper, nSet=upper_top, field=displacement, 1=0.0, 2=-0.15

** step 2: drag across the master surface
*step, solver=theSolver
maxInc=0.1, minInc=1e-6, maxNumInc=100, maxIter=25, stepLength=1
>>options, category=NISTSolver, extrapolation=off
>>dirichlet, name=fixLower, nSet=lower_bottom, field=displacement, 1=0.0, 2=0.0
>>dirichlet, name=holdUpper, nSet=upper_top, field=displacement, 1=0.4, 2=0.0
