*material, name=linearelastic, id=mat, provider=edelweiss
30000.0, 0.2

*section, name=section1, thickness=1.0, material=mat, type=plane
all

*job, name=job, domain=2d
*solver, solver=NIST, name=theSolver

*modelGenerator, generator=planeRectQuad, name=gen
x0=0, l=40, y0=0, h=10, elType=CPE8R, elProvider=edelweiss, nX=4, nY=2

*fieldOutput
>>perNode, name=displacement, elSet=all, field=displacement, result=U
>>perElement, name=stress, elSet=all, result=stress, quadraturePoint=0:4
>>perElement, name=strain, elSet=all, result=strain, quadraturePoint=0:4

*output, type=ensight, name=esExport
>>perNode, fieldOutput=displacement
>>perQuadraturePoint, fieldOutput=stress
>>perQuadraturePoint, fieldOutput=strain
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=0.5, minInc=1e-5, maxNumInc=10, maxIter=25
>>dirichlet, name=left, nSet=gen_left, field=displacement, 1=0.0, 2=0.0
>>dirichlet, name=right, nSet=gen_right, field=displacement, 2=-0.5
