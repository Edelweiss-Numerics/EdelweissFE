** MANUAL matched-mesh variant of the explicit tie test (2 vs 2 elements, zero initial gap):
** with matching meshes the tie's folded masses and forces coincide exactly with those of the
** monolithic mesh (test_merged.inp), so the central-difference trajectories are identical to
** machine precision -- the strongest correctness statement for the explicit tie path. Compare
** the RFBottom histories of both decks.
*material, name=LinearElastic, id=linearelastic, provider=edelweiss
100, 0.0, 1.0

*job, name=tiejobned, domain=2d
*solver, solver=NED, name=theSolver
second-order-fields="displacement"
output-frequency=10

*modelGenerator, generator=planeRectQuad, name=lower
nX      =2
nY      =2
x0      =0
y0      =0
l       =1
h       =1
elType  =CPE4
elProvider =edelweiss

*modelGenerator, generator=planeRectQuad, name=upper
nX      =2
nY      =2
x0      =0
y0      =1.0
l       =1
h       =1
elType  =CPE4
elProvider =edelweiss

*modelGenerator, generator=surfaceElementGenerator, name=gen1
surface = upper_bottom
name    = slaveSurf

*modelGenerator, generator=surfaceElementGenerator, name=gen2
surface = lower_top
name    = masterSurf

*section, name=section1, thickness=1.0, material=linearelastic, type=plane
lower_all
upper_all

*constraint, name=tie1, type=tie
slaveSurface=slaveSurf_facets, masterSurface=masterSurf_facets

*fieldOutput
>>perNode, elSet=lower_all, field=displacement, result=U, name=dispLower
>>perNode, elSet=upper_all, field=displacement, result=U, name=dispUpper
>>perNode, name=RFBottom, nSet=lower_bottom, field=displacement, result=P, f(x)='sum(x[:,1])', saveHistory=True

*output, type=monitor, name=monitor
fieldOutput=RFBottom

*step, type=adaptiveForExplicitSimulations, solver=theSolver
maxInc=1e0, minInc=1e-2, maxNumInc=10000, maxIter=25, stepLength=1
>>dirichlet, name=fixBottom, nSet=lower_bottom, field=displacement, 1=0, 2=0
>>dirichlet, name=pushTop, nSet=upper_top, field=displacement, 2=-0.05
