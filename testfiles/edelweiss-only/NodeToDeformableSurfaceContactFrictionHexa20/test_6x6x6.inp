** Heavy manual variant (6x6x6 C3D20 blocks, NISTParallel) -- deliberately NOT named test.inp so
** the test runner skips it (pipeline budget is a few seconds; this runs ~40 s on several threads). Run directly:
** edelweissfe test_6x6x6.inp   (reference solution: U_6x6x6.ref)
**
*material, name=LinearElastic, id=linearelastic, provider=edelweiss
1.8e4, 0.3

*job, name=contactjob, domain=3d
*solver, solver=NISTParallel, name=theSolver

*modelGenerator, generator=boxGen, name=lower
nX      =6
nY      =6
nZ      =6
x0      =0
y0      =0
z0      =0
lX      =2
lY      =2
lZ      =1
elProvider =edelweiss
elType  =C3D20

*modelGenerator, generator=boxGen, name=upper
nX      =6
nY      =6
nZ      =6
x0      =0.3
y0      =1.1
z0      =1.05
lX      =0.6
lY      =0.6
lZ      =1
elProvider =edelweiss
elType  =C3D20

*modelGenerator, generator=surfaceElementGenerator, name=gen1
surface = upper_back
name    = slaveSurf
triangulation = midside

*modelGenerator, generator=surfaceElementGenerator, name=gen2
surface = lower_front
name    = masterSurf
triangulation = midside

*section, name=section1, material=linearelastic, type=solid
lower_all
upper_all

** the quadratic force law is deliberate: its stiffness vanishes continuously at gap activation,
** which keeps the frictional tangent continuous for nodes lifting off/touching down at the
** tilting trailing/leading edges during the drag (the linear law's activation stiffness jump
** makes Newton limit-cycle there)
*constraint, name=contact, type=nodeToDeformableSurfacePenalty
slaveSurface=slaveSurf_facets, masterSurface=masterSurf_facets, penalty=3e7, type=quadratic,
searchDistance=2.0, sliding=small, mu=0.3, tangentPenalty=1e6

*fieldOutput
>>perNode, elSet=lower_all, field=displacement, result=U, name=dispLower
>>perNode, elSet=upper_all, field=displacement, result=U, name=dispUpper
>>perNode, name=RFDrag,   nSet=lower_back, field=displacement, result=P, f(x)='sum(x[:,0])', saveHistory=True
>>perNode, name=RFNormal, nSet=lower_back, field=displacement, result=P, f(x)='sum(x[:,2])', saveHistory=True

*output, type=ensight, name=esExport
>>perNode, fieldOutput=dispLower
>>perNode, fieldOutput=dispUpper
>>configuration, overwrite=yes

*output, type=monitor, name=monitor
fieldOutput=RFDrag
fieldOutput=RFNormal

** step 1: press the small upper block onto the large lower block (closes the initial 0.05 gap,
** then compresses by 0.05)
*step, solver=theSolver
maxInc=0.05, minInc=1e-6, maxNumInc=200, maxIter=25, stepLength=1
>>options, name=theSolver, extrapolation=off
>>dirichlet, name=fixLower, nSet=lower_back, field=displacement, 1=0.0, 2=0.0, 3=0.0
>>dirichlet, name=holdUpper, nSet=upper_front, field=displacement, 1=0.0, 2=0.0, 3=-0.2

** step 2: drag the compressed upper block 0.8 across the lower block's surface -- the slave
** nodes slide over several master facet columns, exercising per-increment reassignment of the
** frozen small-sliding projection and the frictional stick-slip history
*step, solver=theSolver
maxInc=0.02, minInc=1e-6, maxNumInc=200, maxIter=25, stepLength=1
>>options, name=theSolver, extrapolation=off
>>dirichlet, name=fixLower, nSet=lower_back, field=displacement, 1=0.0, 2=0.0, 3=0.0
>>dirichlet, name=holdUpper, nSet=upper_front, field=displacement, 1=0.8, 2=0.0, 3=0.0
