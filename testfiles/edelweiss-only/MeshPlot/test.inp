** Coverage for the meshplot output manager, using only pure-Python elements and materials.
**
** Every other meshplot input lives under testfiles/marmot/ and needs a Marmot element or material,
** so meshplot had no executing coverage at all (P2 finding (vii)). This input exercises all four
** `create=` job kinds plus a `saveFigure` job, so that porting meshplot to
** an L2 schema is verifiable rather than review-only. `run_tests_edelweissfe` sets the matplotlib
** "Agg" backend, so the plotting paths run headless.

*material, name=linearelastic, id=linearelastic, provider=edelweiss
210000.0, 0.15

*section, name=section1, thickness=50.0, material=linearelastic, type=plane
all

*job, name=meshPlotJob, domain=2d
*solver, solver=NIST, name=theSolver

*fieldOutput
** elSet-based, so it is usable both as a create=perNode source and as warpBy
>>perNode, elSet=all, field=displacement, result=U, name=displacement
>>perNode, elSet=all, field=displacement, result=U, name=uMag, f(x)='linalg.norm(x, axis=1)'
>>perElement, elSet=all, result=stress, name=stress, quadraturePoint=0:4, f(x)='np.mean(x,axis=1)'
** history-saving pair for the xyData job
>>perNode, nSet=gen_top, field=displacement, result=U, name=uTop, f(x)='mean(x[:,1])', saveHistory=True
>>perNode, nSet=gen_bottom, field=displacement, result=P, name=RF, f(x)='sum(x[:,1])', saveHistory=True

*modelGenerator, generator=planeRectQuad, name=gen
x0=0, l=50
y0=0, h=200
elType=CPE4
elProvider=edelweiss
nX=2
nY=8

*output, type=meshplot, name=thePlots
create=xyData, x=uTop, y=RF, figure=1, axSpec=211, c=red, ls=dashed, label=RF(u), integral=True
create=perNode, fieldOutput=uMag, figure=1, axSpec=212, label=|u|
create=perElement, fieldOutput=stress, figure=2, axSpec=211, f(x)='mean(x, axis=1)', label=meanStress
create=meshOnly, figure=2, axSpec=212, configuration=deformed, warpBy=displacement, scaleFactor=10.0
saveFigure, figure=2, name=meshPlotFigure, png=True

*step, solver=theSolver
maxInc=5e-1, minInc=1e-8, maxNumInc=1000, maxIter=25, stepLength=1
>>dirichlet, name=bottom, nSet=gen_bottom, field=displacement, 2=0, 1=0
>>nodeforces, name=cloadTop, nSet=gen_top, components='0,5000.0', field=displacement
